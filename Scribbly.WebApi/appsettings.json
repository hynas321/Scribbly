{
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379,abortConnect=false",
    "KeyPrefix": "scribbly",
    "GameTtlHours": 24,
    "LockTimeoutSeconds": 5,
    "LockLeaseSeconds": 15,
    "SessionLeaseSeconds": 30
  },
  "Game": {
    "ReconnectGracePeriodSeconds": 120,
    "DisconnectedPlayerCleanupIntervalSeconds": 15,
    "MaxPlayers": 12,
    "JoinCredentialLifetimeSeconds": 45
  },
  "Canvas": {
    "Width": 670,
    "Height": 470,
    "MaxPointsPerChunk": 64,
    "MaxPointsPerStroke": 4096,
    "MaxStrokes": 128,
    "MaxTotalPoints": 100000,
    "MaxStrokeIdLength": 64,
    "MinThickness": 1,
    "MaxThickness": 64,
    "DefaultThickness": 5,
    "ThicknessStep": 3,
    "SampleIntervalMilliseconds": 25,
    "FlushIntervalMilliseconds": 50
  },
  "Chat": {
    "MaxMessageCount": 25,
    "MaxMessageLength": 280
  },
  "Prompt": {
    "MaxTextLength": 120,
    "MaxCategoryLength": 64
  },
  "GameSettings": {
    "MinDrawingTimeSeconds": 30,
    "MaxDrawingTimeSeconds": 120,
    "DrawingTimeStepSeconds": 15,
    "MinRounds": 1,
    "MaxRounds": 6,
    "MinPlayers": 2,
    "MaxPlayers": 10,
    "MaxPromptCategoryLength": 64,
    "MinHintPercentage": 25,
    "MaxHintPercentage": 75,
    "HintPercentageStep": 25
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Console": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://scribbly.azurewebsites.net"
    ]
  },
  "Authentication": {
    "SessionLifetimeHours": 168
  }
}
